{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/clojurescript {:mvn/version "1.11.132"}
        ;; worlds, savepoints, world scopes, traces: the substrate foerster
        ;; runs inference on. 0.1.89: canonical particles are copies (#94);
        ;; 0.1.90: effect adapters as functions (dispatch in ClojureScript).
        ;; 0.1.92: a forked child's completion resumes its parent in its own world.
        ;; 0.1.96: trace :until, replay :seed, O(log n) world release.
        ;; 0.1.102: overlays skip tombstone scans without tombstones (2x SMC).
        ;; 0.1.103: overlay entity writes rebuild once (round-2 performance).
        ;; 0.1.126: spread! on an inline executor uses one worker (SMC on the
        ;; synchronous executor no longer overflows the stack and hangs).
        ;; 0.1.137: a frozen world owns the maps it writes whole, so a replay
        ;; no longer pays the size of the world at every spin it records.
        ;; 0.1.140: keyed loops, world quiescence and trace/update, which
        ;; update-step moves by.
        org.replikativ/spindel {:mvn/version "0.1.140"}
        org.replikativ/logging {:mvn/version "0.1.3"}}

 :aliases
 {:test {:extra-paths ["test"]
         ;; An access to a runtime atom, deferred or mailbox from a world that
         ;; has no state for it fails the test instead of warning.
         :jvm-opts ["-Dspindel.missing-state=throw"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}
                 slipset/deps-deploy {:mvn/version "0.2.2"}
                 io.github.borkdude/gh-release-artifact {:git/sha "b946558225a7839f6a0f644834e838e190dc2262"}
                 babashka/babashka.curl {:mvn/version "0.1.2"}
                 babashka/fs {:mvn/version "0.3.17"}
                 cheshire/cheshire {:mvn/version "5.11.0"}}
          :ns-default build}

  ;; Simulation-based calibration of the samplers: a seeded statistical
  ;; experiment, not part of the suite. `clojure -M:test:sbc [simulations]`.
  :sbc {:extra-paths ["test" "experiments"]
        ;; the χ² test of the rank histograms
        :extra-deps {org.apache.commons/commons-math3 {:mvn/version "3.6.1"}}
        :main-opts ["-m" "org.replikativ.foerster.sbc"]}

  ;; exactness of particle Gibbs with resample-move on a model where the
  ;; old construction is biased; ~20 min. `clojure -M:test:enumerate`
  :enumerate {:extra-paths ["test" "experiments"]
              :main-opts ["-m" "org.replikativ.foerster.pgibbs-exactness"]}

;; accuracy and speed against posteriordb's reference posteriors
  ;; (Magnusson et al. 2025): a benchmark, not part of the suite; fetches the
  ;; posteriors it runs into ~/.cache/foerster/posteriordb.
  ;; `clojure -M:test:posteriordb [posterior …]`
  :posteriordb {:extra-paths ["test" "experiments"]
                :extra-deps {cheshire/cheshire {:mvn/version "5.11.0"}}
                :main-opts ["-m" "org.replikativ.foerster.posteriordb"]}

  ;; Bayesian-workflow environments for dvergr agents: tasks verified against
  ;; posteriordb reference posteriors. Not part of the suite or the jar.
  ;; Spindel at the version dvergr is built against; dvergr's own (older)
  ;; foerster is excluded, this checkout's src stands in for it.
  :workflow {:extra-paths ["test" "experiments"]
             :extra-deps {org.replikativ/dvergr {:mvn/version "0.1.257" :exclusions [org.replikativ/foerster]}
                          org.replikativ/spindel {:mvn/version "0.1.126"}
                          cheshire/cheshire {:mvn/version "5.11.0"}}}
  ;; What a single-site move costs as the data grow: the baseline for
  ;; incremental densities. `clojure -M:incremental [sizes…]`.
  :incremental {:extra-paths ["experiments"]
                :main-opts ["-m" "org.replikativ.foerster.incremental-baseline"]}

  :repl {:extra-deps {nrepl/nrepl {:mvn/version "1.1.2"}
                      cider/cider-nrepl {:mvn/version "0.49.3"}}}

  ;; The tutorials: Clay notebooks in notebooks/foerster, rendered to the
  ;; site by `clojure -M:notebooks -m render` (CI on every PR; Pages on main).
  :notebooks {:extra-paths ["notebooks" "test"]
              :extra-deps {org.scicloj/kindly {:mvn/version "4-beta23"}
                           org.scicloj/clay {:mvn/version "2.0.13"}
                           org.scicloj/tableplot {:mvn/version "1-beta17"}
                           scicloj/tablecloth {:mvn/version "8.021"}}}

  :cljs {:extra-paths ["test"]
         :extra-deps {thheller/shadow-cljs {:mvn/version "2.28.21"}}}

  ;; Code formatting check (CI uses this; clj -M:format)
  :format {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
           :main-opts ["-m" "cljfmt.main" "check" "src" "test" "experiments"]}

  ;; Code formatting fix (clj -M:ffix)
  :ffix   {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
           :main-opts ["-m" "cljfmt.main" "fix" "src" "test" "experiments"]}}}
