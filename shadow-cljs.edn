;; shadow-cljs configuration for foerster's ClojureScript tests.
;; Uses deps.edn for dependency resolution via the :cljs alias.
{:deps {:aliases [:cljs]}

 :builds
 {;; Local test runner: `npx shadow-cljs compile test`.
  :test
  {:target :node-test
   :output-to "target/test.js"
   :ns-regexp "-test$"
   :autorun true
   :compiler-options {:optimizations :none}}

  ;; CI build, called by the replikativ/clj-tools@0 orb (tools/build:
  ;; `npx shadow-cljs compile ci`; tools/cljstest: bin/run-cljstests).
  :ci
  {:target :node-test
   :output-to "out/ci-tests.js"
   :ns-regexp "-test$"
   :compiler-options {:elide-asserts false}}}}
